# ai-dev-flow — configuration for skills/agents that need external services.
#
# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
# Loaded automatically by scripts/mcp-grafana-env.sh (used by the observability-analyst
# and observability-builder agents) and by skills/obs-apply/scripts/apply.sh.
#
# Variables here take precedence over ones already exported in your shell, but if a
# variable is missing here and already exported in your shell, that still works —
# this file only needs to cover what you want centralized in one place.

# --- Grafana: read-only access (observability-analyst, observability-builder) ---
# Service account role: Viewer. Never put an Editor/Admin token here — these two
# agents are read-only by design (see agents/observability-analyst.md).
GRAFANA_URL=
GRAFANA_SERVICE_ACCOUNT_TOKEN=

# --- Grafana: write access (obs-apply only) ---
# Service account role: Editor (or Admin if you also need folder creation).
# Deliberately a separate token from GRAFANA_SERVICE_ACCOUNT_TOKEN above — the
# read-only agents must never be able to reach this one.
GRAFANA_ADMIN_TOKEN=
